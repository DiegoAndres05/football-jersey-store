# Telegram notifications (server-only)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Database — PostgreSQL (Supabase)
# DATABASE_URL = conexión pooled (Session pooler, puerto 6543, ?pgbouncer=true)
# DIRECT_URL   = conexión directa (puerto 5432) — usada por Prisma Migrate
DATABASE_URL="postgresql://postgres.PROJECT_REF:SUPABASE_PASSWORD@aws-0-us-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://postgres.PROJECT_REF:SUPABASE_PASSWORD@aws-0-us-east-1.supabase.com:5432/postgres"

# Secretos (cambia esto en producción)
NEXTAUTH_SECRET="local-dev-secret-change-me-in-production-please"
NEXTAUTH_URL="http://localhost:3000"

# URL pública del sitio (OBLIGATORIA en producción, HTTPS, sin path ni slash final)
# En producción sin esta variable, el build falla. En desarrollo se permite localhost.
NEXT_PUBLIC_SITE_URL="https://flashsport.co"

# FKA browser transport (server-only; never expose these to the client).
# Local development: point to Brave/Chrome started with --remote-debugging-port=9222.
# Production: leave FKA_CDP_ENDPOINT empty and configure Browserbase credentials.
FKA_CDP_ENDPOINT="http://127.0.0.1:9222"
FKA_BROWSERBASE_API_KEY=""
FKA_BROWSERBASE_PROJECT_ID=""

# Pasarela de pagos (en MVP es simulado, pero dejamos la variable lista)
PAYMENT_PROVIDER="mock"
# Public checkout can use only the explicit Bold sandbox mode. Keep all keys server-only.
# PAYMENT_PROVIDER="bold-sandbox"

# Bold payment gateway (Botón de pagos)
# Use the matching pair from Bold → Integraciones → Botón de pagos.
# Test identity + test secret for "Modo de pruebas" and Bold test cards.
# Production identity + production secret for live charges.
# Never mix test and production keys.
BOLD_IDENTITY_KEY=
BOLD_SECRET_KEY=

# Approved legal documents (all URLs must be HTTPS; missing values fail closed)
LEGAL_TERMS_KEY="terms"
LEGAL_TERMS_VERSION="draft"
LEGAL_TERMS_URL="https://example.com/terminos"
LEGAL_PRIVACY_KEY="privacy"
LEGAL_PRIVACY_VERSION="draft"
LEGAL_PRIVACY_URL="https://example.com/privacidad"
LEGAL_DATA_PROCESSING_KEY="data-processing"
LEGAL_DATA_PROCESSING_VERSION="draft"
LEGAL_DATA_PROCESSING_URL="https://example.com/tratamiento-datos"
LEGAL_RETURNS_KEY="returns"
LEGAL_RETURNS_VERSION="draft"
LEGAL_RETURNS_URL="https://example.com/cambios-devoluciones"
