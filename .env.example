# Telegram notifications (server-only)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Correo transaccional al cliente (server-only). Resend.
# EMAIL_FROM solo se usa en el correo de compra. Las campañas no lo leen.
RESEND_API_KEY=
EMAIL_FROM=
# Remitente del newsletter (server-only). Sin esta variable las campañas no se envían.
# Formato Resend: Nombre <correo@dominio> o solo el correo.
# Verificar en Resend que el dominio autoriza esta dirección antes de usarla en producción.
NEWSLETTER_FROM="Flashsport <novedades@flashsports.shop>"
# Database — PostgreSQL (Supabase)
# DATABASE_URL = conexión pooled (Session pooler, puerto 6543, ?pgbouncer=true)
# DIRECT_URL   = conexión directa (puerto 5432) — usada por Prisma Migrate
DATABASE_URL="postgresql://postgres.PROJECT_REF:SUPABASE_PASSWORD@aws-0-us-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://postgres.PROJECT_REF:SUPABASE_PASSWORD@aws-0-us-east-1.supabase.com:5432/postgres"
# Auth del personal (Supabase Auth). La anon key es pública; el service role no.
# STAFF_AUTH_CUTOVER=true rechaza la cookie antigua fs_admin_session.
# Actívalo solo después de que el administrador actual haya ingresado una vez con Supabase.
NEXT_PUBLIC_SUPABASE_URL="https://PROJECT_REF.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
STAFF_AUTH_CUTOVER=false

# Secretos (cambia esto en producción)
NEXTAUTH_SECRET="local-dev-secret-change-me-in-production-please"
NEXTAUTH_URL="http://localhost:3000"

# URL pública del sitio (OBLIGATORIA en producción, HTTPS, sin path ni slash final)
# En producción sin esta variable, el build falla. En desarrollo se permite localhost.
NEXT_PUBLIC_SITE_URL="https://www.flashsports.shop"

# Importador Football Kit Archive (/admin/importar). Solo servidor; nunca NEXT_PUBLIC_*.
# Solo se usa desde Next.js local + Brave CDP. No configurar en Vercel.
FKA_IMPORTER_ENABLED=true
FKA_CDP_ENDPOINT="http://127.0.0.1:9222"
# Arranque de Brave:
# /Applications/Brave\ Browser.app/Contents/MacOS/Brave\ Browser --remote-debugging-port=9222

# Pasarela de pagos (en MVP es simulado, pero dejamos la variable lista)
PAYMENT_PROVIDER="mock"
# Public checkout can use only the Bold sandbox mode ("bold" is an alias of "bold-sandbox").
# Keep all keys server-only. Sandbox webhooks are signed with an empty key.
# PAYMENT_PROVIDER="bold-sandbox"

# Bold payment gateway (Botón de pagos)
# Use the matching pair from Bold → Integraciones → Botón de pagos.
# Test identity + test secret for "Modo de pruebas" and Bold test cards.
# Production identity + production secret for live charges.
# Never mix test and production keys.
BOLD_IDENTITY_KEY=
BOLD_SECRET_KEY=

# PayPal (server-only). Destinos distintos de Colombia.
# PAYPAL_ENV=sandbox usa api-m.sandbox.paypal.com. live o production usa la API real.
# PAYPAL_WEBHOOK_ID es el id del webhook en PayPal (eventos de captura).
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_ENV=sandbox

# Approved legal documents (all URLs must be HTTPS; missing values fail closed)
LEGAL_TERMS_KEY="terms"
LEGAL_TERMS_VERSION="draft"
LEGAL_TERMS_URL="https://www.flashsports.shop/terminos"
LEGAL_PRIVACY_KEY="privacy"
LEGAL_PRIVACY_VERSION="draft"
LEGAL_PRIVACY_URL="https://www.flashsports.shop/privacidad"
LEGAL_DATA_PROCESSING_KEY="data-processing"
LEGAL_DATA_PROCESSING_VERSION="draft"
LEGAL_DATA_PROCESSING_URL="https://www.flashsports.shop/tratamiento-datos"
LEGAL_RETURNS_KEY="returns"
LEGAL_RETURNS_VERSION="draft"
LEGAL_RETURNS_URL="https://www.flashsports.shop/cambios-devoluciones"
